{
  "name": "videotube",
  "version": "1.0.0",
  "description": "VideoTube - a production-ready video hosting backend API (upload, stream, like, comment, subscribe, playlists) built with Node.js, Express and MongoDB.",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "nodemon -r dotenv/config --experimental-json-modules src/index.js",
    "start": "node -r dotenv/config src/index.js"
  },
  "keywords": [
    "javascript",
    "backend",
    "videotube",
    "express",
    "mongodb"
  ],
  "author": "Aadarsh",
  "license": "ISC",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "prettier": "^3.0.3"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cloudinary": "^1.41.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.0",
    "mongoose-aggregate-paginate-v2": "^1.0.6",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1"
  }
